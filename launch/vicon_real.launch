<launch>

    <!-- ========================================================= -->
    <!-- VEHICLE CONFIGURATION                                    -->
    <!-- ========================================================= -->

    <arg name="leader_number" default="2"/>
    <arg name="follower_number" default="3"/>


    <!-- ========================================================= -->
    <!-- OCO / SPACING PARAMETERS                                 -->
    <!-- ========================================================= -->

    <arg name="standstill_distance" default="1.0"/>
    <arg name="time_headway" default="0.5"/>

    <arg name="measurement_rate" default="10.0"/>


    <!-- ========================================================= -->
    <!-- VICON FILTERING                                          -->
    <!--                                                         -->
    <!-- Only applies to the separate pure-Vicon measurement bank.-->
    <!-- ========================================================= -->

    <arg name="velocity_cutoff" default="3.0"/>
    <arg name="acceleration_cutoff" default="2.0"/>


    <!-- ========================================================= -->
    <!-- ONBOARD LONGITUDINAL MEASUREMENTS                        -->
    <!--                                                         -->
    <!-- These are already conditioned on each JetRacer.          -->
    <!--                                                         -->
    <!-- Velocity:                                                -->
    <!--   encoder -> 2 Hz LPF                                    -->
    <!--                                                         -->
    <!-- Acceleration:                                            -->
    <!--   encoder -> 0.5 Hz LPF -> differentiation              -->
    <!--                                                         -->
    <!-- NO additional filtering is performed on WSL.            -->
    <!-- ========================================================= -->

    <arg name="leader_velocity_topic"
         default="/encoder_velocity_2"/>

    <arg name="leader_acceleration_topic"
         default="/measured_acceleration_2"/>

    <arg name="follower_velocity_topic"
         default="/encoder_velocity_3"/>

    <arg name="follower_acceleration_topic"
         default="/measured_acceleration_3"/>

    <arg name="sensor_timeout" default="0.25"/>


    <!-- ========================================================= -->
    <!-- ATTACK CONFIGURATION                                     -->
    <!-- ========================================================= -->

    <arg name="attack_enabled" default="false"/>

    <!--
        Options:
            none
            white_noise
            switching_white_noise
            step
            switching_step
    -->
    <arg name="attack_type" default="none"/>

    <arg name="attack_channels" default="[]"/>

    <arg name="step_amplitude" default="1.0"/>
    <arg name="white_noise_std" default="1.0"/>

    <arg name="attack_start" default="10.0"/>
    <arg name="attack_stop" default="-1.0"/>

    <arg name="switching_period" default="10.0"/>
    <arg name="switching_on_time" default="5.0"/>


    <!-- ========================================================= -->
    <!-- RAW VICON BRIDGE                                         -->
    <!-- ========================================================= -->

    <include file="$(find vicon_pkg)/launch/jetracer_all_stream.launch"/>


    <!-- ========================================================= -->
    <!-- VICON + ONBOARD OCO MEASUREMENT GENERATOR                -->
    <!--                                                         -->
    <!-- Vicon:                                                   -->
    <!-- /vicon/jetracer2                                        -->
    <!-- /vicon/jetracer3                                        -->
    <!--                                                         -->
    <!-- Conditioned onboard measurements:                        -->
    <!-- /encoder_velocity_2                                     -->
    <!-- /measured_acceleration_2                                -->
    <!-- /encoder_velocity_3                                     -->
    <!-- /measured_acceleration_3                                -->
    <!--                                                         -->
    <!-- Pure Vicon bank:                                         -->
    <!-- /oco/y1_3 ... /oco/y9_3                                -->
    <!--                                                         -->
    <!-- Onboard/hybrid bank:                                     -->
    <!-- /oco_onboard/y1_3 ... /oco_onboard/y9_3                -->
    <!--                                                         -->
    <!-- The onboard bank still uses Vicon for distance only.     -->
    <!-- ========================================================= -->

    <node
        pkg="platoon_observer"
        type="vicon_oco_measurements.py"
        name="vicon_oco_measurements"
        output="screen"
        required="true">

        <!-- Vehicle configuration -->

        <param name="leader_number"
               value="$(arg leader_number)"/>

        <param name="follower_number"
               value="$(arg follower_number)"/>


        <!-- Vicon inputs -->

        <param name="leader_vicon_topic"
               value="/vicon/jetracer$(arg leader_number)"/>

        <param name="follower_vicon_topic"
               value="/vicon/jetracer$(arg follower_number)"/>


        <!-- Conditioned onboard longitudinal inputs -->

        <param name="leader_velocity_topic"
               value="$(arg leader_velocity_topic)"/>

        <param name="leader_acceleration_topic"
               value="$(arg leader_acceleration_topic)"/>

        <param name="follower_velocity_topic"
               value="$(arg follower_velocity_topic)"/>

        <param name="follower_acceleration_topic"
               value="$(arg follower_acceleration_topic)"/>


        <!-- Platoon parameters -->

        <param name="standstill_distance"
               value="$(arg standstill_distance)"/>

        <param name="headway"
               value="$(arg time_headway)"/>


        <!-- Pure-Vicon processing -->

        <param name="publish_rate"
               value="$(arg measurement_rate)"/>

        <param name="velocity_cutoff_hz"
               value="$(arg velocity_cutoff)"/>

        <param name="acceleration_cutoff_hz"
               value="$(arg acceleration_cutoff)"/>


        <!-- Freshness checks for onboard topics -->

        <param name="sensor_timeout"
               value="$(arg sensor_timeout)"/>


        <!-- Attack parameters -->

        <param name="attack_enabled"
               value="$(arg attack_enabled)"/>

        <param name="attack_type"
               value="$(arg attack_type)"/>

        <rosparam param="attack_channels"
                  subst_value="true">
            $(arg attack_channels)
        </rosparam>

        <param name="step_amplitude"
               value="$(arg step_amplitude)"/>

        <param name="white_noise_std"
               value="$(arg white_noise_std)"/>

        <param name="attack_start"
               value="$(arg attack_start)"/>

        <param name="attack_stop"
               value="$(arg attack_stop)"/>

        <param name="switching_period"
               value="$(arg switching_period)"/>

        <param name="switching_on_time"
               value="$(arg switching_on_time)"/>

    </node>

</launch>
