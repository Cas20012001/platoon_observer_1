<launch>

    <!-- ========================================================= -->
    <!-- LEADER CONFIGURATION                                     -->
    <!-- ========================================================= -->

    <arg name="car_number" default="2"/>

    <arg name="vicon_topic"
         default="/vicon/jetracer$(arg car_number)"/>

    <arg name="vicon_velocity_topic"
         default="/vicon_velocity_$(arg car_number)"/>

    <arg name="v_ref_topic"
         default="/v_ref_$(arg car_number)"/>

    <arg name="desired_acc_topic"
         default="/desired_acc_$(arg car_number)"/>

    <arg name="steering_angle_topic"
         default="/steering_angle_$(arg car_number)"/>


    <!-- ========================================================= -->
    <!-- CONTROLLER PARAMETERS                                    -->
    <!-- ========================================================= -->

    <arg name="kp" default="1.0"/>

    <arg name="min_acc" default="-1.0"/>
    <arg name="max_acc" default="1.0"/>

    <arg name="control_rate" default="10.0"/>

    <arg name="velocity_timeout" default="0.25"/>
    <arg name="vicon_timeout" default="0.25"/>


    <!-- ========================================================= -->
    <!-- CIRCLE PARAMETERS                                        -->
    <!-- ========================================================= -->

    <arg name="center_x" default="0.0"/>
    <arg name="center_y" default="0.0"/>

    <arg name="radius" default="2.5"/>

    <!-- +1 = counterclockwise, -1 = clockwise -->
    <arg name="direction" default="1"/>

    <arg name="lookahead" default="0.6"/>

    <arg name="wheelbase" default="0.175"/>

    <arg name="max_steering_angle" default="0.45"/>

    <arg name="steering_sign" default="1.0"/>

    <arg name="yaw_offset" default="0.0"/>

    <arg name="delay" default="0.165"/>


    <!-- ========================================================= -->
    <!-- ROS SERIAL / ARDUINO                                     -->
    <!--                                                         -->
    <!-- Arduino -> /arduino_data_2                               -->
    <!-- ========================================================= -->

    <node
        pkg="rosserial_python"
        type="serial_node.py"
        name="serial_node_$(arg car_number)"
        output="screen">

        <param name="port" value="/dev/arduino"/>
        <param name="baud" value="57600"/>

    </node>


    <!-- ========================================================= -->
    <!-- COMBINED ONBOARD SENSOR TOPIC                            -->
    <!--                                                         -->
    <!-- /arduino_data_2 -> /sensors_and_input_2                  -->
    <!-- ========================================================= -->

    <node
        pkg="racecar_pkg"
        type="publish_sensors_and_inputs_universal.py"
        name="publish_sensors_and_inputs_$(arg car_number)"
        output="screen">

        <env
            name="car_number"
            value="$(arg car_number)"/>

    </node>


    <!-- ========================================================= -->
    <!-- SAFETY HEARTBEAT                                         -->
    <!--                                                         -->
    <!-- racecar_universal requires repeated safety messages.     -->
    <!-- ========================================================= -->

    <node
        pkg="rostopic"
        type="rostopic"
        name="leader_safety_publisher"
        output="screen"
        args="pub /safety_value std_msgs/Float32 'data: 1.0' -r 10">
    </node>


    <!-- ========================================================= -->
    <!-- PHYSICAL RACECAR INTERFACE                               -->
    <!--                                                         -->
    <!-- /throttle_2                                              -->
    <!-- /steering_2                                              -->
    <!-- /safety_value                                            -->
    <!--       -> NvidiaRacecar                                   -->
    <!-- ========================================================= -->

    <node
        pkg="racecar_pkg"
        type="racecar_universal.py"
        name="racecar_$(arg car_number)"
        output="screen"
        required="true">

        <env
            name="car_number"
            value="$(arg car_number)"/>

    </node>


    <!-- ========================================================= -->
    <!-- LEADER VELOCITY CONTROLLER                              -->
    <!--                                                         -->
    <!-- /v_ref_2 + /vicon_velocity_2                             -->
    <!--          -> /desired_acc_2                               -->
    <!-- ========================================================= -->

    <node
        pkg="platoon_observer"
        type="v_tracking_controller_real.py"
        name="leader_velocity_controller_real_$(arg car_number)"
        output="screen"
        required="true">

        <param name="car_number"
               value="$(arg car_number)"/>

        <param name="velocity_topic"
               value="$(arg vicon_velocity_topic)"/>

        <param name="v_ref_topic"
               value="$(arg v_ref_topic)"/>

        <param name="desired_acc_topic"
               value="$(arg desired_acc_topic)"/>

        <param name="kp"
               value="$(arg kp)"/>

        <param name="min_acc"
               value="$(arg min_acc)"/>

        <param name="max_acc"
               value="$(arg max_acc)"/>

        <param name="control_rate"
               value="$(arg control_rate)"/>

        <param name="velocity_timeout"
               value="$(arg velocity_timeout)"/>

    </node>


    <!-- ========================================================= -->
    <!-- DESIRED ACCELERATION -> THROTTLE                         -->
    <!--                                                         -->
    <!-- /desired_acc_2                                           -->
    <!-- /sensors_and_input_2                                     -->
    <!-- /steering_2                                              -->
    <!--        -> /throttle_2                                    -->
    <!--        -> /acc_saturated_2                               -->
    <!-- ========================================================= -->

    <node
        pkg="platooning_pkg"
        type="acc_2_throttle.py"
        name="acc_2_throttle_$(arg car_number)"
        output="screen"
        required="true">

        <env
            name="car_number"
            value="$(arg car_number)"/>

    </node>


    <!-- ========================================================= -->
    <!-- REAL CIRCLE CONTROLLER                                   -->
    <!--                                                         -->
    <!-- /vicon/jetracer2                                        -->
    <!-- /vicon_velocity_2                                       -->
    <!--       -> /steering_angle_2                              -->
    <!-- ========================================================= -->

    <node
        pkg="platoon_lateral_controller"
        type="circle_lateral_controller_real.py"
        name="circle_lateral_controller_real_$(arg car_number)"
        output="screen"
        required="true">

        <param name="car_number"
               value="$(arg car_number)"/>

        <param name="vicon_topic"
               value="$(arg vicon_topic)"/>

        <param name="velocity_topic"
               value="$(arg vicon_velocity_topic)"/>

        <param name="steering_topic"
               value="$(arg steering_angle_topic)"/>

        <param name="center_x"
               value="$(arg center_x)"/>

        <param name="center_y"
               value="$(arg center_y)"/>

        <param name="radius"
               value="$(arg radius)"/>

        <param name="direction"
               value="$(arg direction)"/>

        <param name="lookahead"
               value="$(arg lookahead)"/>

        <param name="wheelbase"
               value="$(arg wheelbase)"/>

        <param name="max_steering_angle"
               value="$(arg max_steering_angle)"/>

        <param name="steering_sign"
               value="$(arg steering_sign)"/>

        <param name="yaw_offset"
               value="$(arg yaw_offset)"/>

        <param name="delay"
               value="$(arg delay)"/>

        <param name="control_rate"
               value="$(arg control_rate)"/>

        <param name="vicon_timeout"
               value="$(arg vicon_timeout)"/>

        <param name="velocity_timeout"
               value="$(arg velocity_timeout)"/>

    </node>


    <!-- ========================================================= -->
    <!-- STEERING ANGLE -> NORMALIZED STEERING COMMAND            -->
    <!--                                                         -->
    <!-- /steering_angle_2 -> /steering_2                         -->
    <!-- Uses the proper per-car calibration from the             -->
    <!-- Jetracer_WS_github version.                              -->
    <!-- ========================================================= -->

    <node
        pkg="racecar_pkg"
        type="steering_angle_2_command.py"
        name="steering_angle_2_steer_control_node_$(arg car_number)"
        output="screen"
        required="true">

        <env
            name="car_number"
            value="$(arg car_number)"/>

    </node>


</launch>
